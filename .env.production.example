# Plantilla para la instalación de un cliente real (no para desarrollo local).
# Partir de .env.example, aplicar estos cambios, y completar los valores
# marcados con "...". Ver el paso a paso completo en README.md.

APP_NAME="Nombre del negocio del cliente"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://...

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

LOG_LEVEL=error

# Con varios usuarios/cajas simultáneas (POS + facturación al mismo tiempo),
# SQLite no da abasto — usar MySQL en cualquier instalación real.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=...
DB_USERNAME=...
DB_PASSWORD=...

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Si el sitio va por HTTPS (debería, siempre en producción):
SESSION_SECURE_COOKIE=true

MAIL_MAILER=smtp
MAIL_HOST=...
MAIL_PORT=587
MAIL_USERNAME=...
MAIL_PASSWORD=...
MAIL_FROM_ADDRESS=...
MAIL_FROM_NAME="${APP_NAME}"

# certificado.crt y privada.key del cliente van en storage/afip/ (nunca se commitean)
AFIP_CUIT=
AFIP_ENV=produccion

# Respaldo automático diario (ver también la tarea programada en README).
BACKUP_PATH=
BACKUP_COPY_TO=
BACKUP_KEEP=14
BACKUP_DAILY_AT=23:30
